APP_PORT=8000
APP_USER=lecturer
APP_PASSWORD=change-this-password
ASR_MODEL=gigaam-v3-e2e-rnnt
MULTILINGUAL_ASR_MODEL=Systran/faster-whisper-small
ASR_CPU_THREADS=3
SUMMARY_CPU_THREADS=3
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FASTEMBED_CACHE_PATH=/var/lib/lectorium/fastembed_cache

# Optional HTTP or SOCKS5 proxy for yt-dlp (for example socks5h://127.0.0.1:9050)
YTDLP_PROXY=
