[Unit]
Description=Lectorium Semantic Search
Wants=tor.service
After=network.target tor.service

[Service]
Type=simple
User=lectorium
Group=lectorium
WorkingDirectory=/opt/lectorium
Environment=DATA_DIR=/var/lib/lectorium/data
Environment=UPLOAD_DIR=/var/lib/lectorium/uploads
Environment=ASR_MODEL=gigaam-v3-e2e-rnnt
Environment=EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
Environment=FASTEMBED_CACHE_PATH=/var/lib/lectorium/fastembed_cache
Environment=STORAGE_KEY_FILE=/etc/lectorium/storage.key
Environment=HOME=/var/lib/lectorium
Environment=YTDLP_PROXY=
EnvironmentFile=/etc/lectorium.env
ExecStart=/opt/lectorium/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001 --workers 1
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
